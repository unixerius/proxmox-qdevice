FROM debian:bookworm-slim
#FROM dhi.io/debian-base:bookworm

RUN apt update \
    && apt -y upgrade \
    && apt install --no-install-recommends -y supervisor openssh-server corosync-qnetd \
    && apt -y autoremove \
    && apt clean all

# Disable password auth and only allow keys
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config \
    && sed -i 's/#PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config

# Copy the SSH initialization script
COPY init_ssh.sh /usr/local/bin/init_ssh.sh
RUN chown root:root /usr/local/bin/init_ssh.sh \
    && chmod 755 /usr/local/bin/init_ssh.sh

RUN mkdir -p /run/sshd /root/.ssh \
    && chmod 700 /root/.ssh

COPY supervisord.conf /etc/supervisord.conf

EXPOSE 22
EXPOSE 5403

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

